{
	"compilerOptions": {
		"noEmit": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"module": "esnext",
		"target": "esnext",

		"baseUrl": "./src",
		"paths": {
			"@pages/*": ["router/pages/*"]
		}
	},
	"include": ["src"]
}
